      <origin rpy="0 0 0" xyz="-0.565 0.08999999999999997 1.93"/>
      <geometry>
        <box size="0.04 0.54 0.04"/>
      </geometry>
      <material name="aluminum_silver"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="-0.565 0.08999999999999997 1.93"/>
      <geometry>
        <box size="0.04 0.54 0.04"/>
      </geometry>
    </collision>
    <!-- Right Overhang Cantilever Beam (54cm forward) -->
    <visual>
      <origin rpy="0 0 0" xyz="0.565 0.08999999999999997 1.93"/>
      <geometry>
        <box size="0.04 0.54 0.04"/>
      </geometry>
      <material name="aluminum_silver"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0.565 0.08999999999999997 1.93"/>
      <geometry>
        <box size="0.04 0.54 0.04"/>
      </geometry>
    </collision>
    <!-- Front Top Crossbar (connecting the cantilever tips) -->
    <visual>
      <origin rpy="0 0 0" xyz="0 -0.16000000000000006 1.93"/>
      <geometry>
        <box size="1.17 0.04 0.04"/>
      </geometry>
      <material name="aluminum_silver"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 -0.16000000000000006 1.93"/>
      <geometry>
        <box size="1.17 0.04 0.04"/>
      </geometry>
    </collision>
    <!-- Left Corner Reinforcement Gusset Plate -->
    <visual>
      <origin rpy="0.785398 0 0" xyz="-0.565 0.25999999999999995 1.8699999999999999"/>
      <geometry>
        <box size="0.01 0.14 0.01"/>
      </geometry>
      <material name="aluminum_dark"/>
    </visual>
    <!-- Right Corner Reinforcement Gusset Plate -->
    <visual>
      <origin rpy="0.785398 0 0" xyz="0.565 0.25999999999999995 1.8699999999999999"/>
      <geometry>
        <box size="0.01 0.14 0.01"/>
      </geometry>
      <material name="aluminum_dark"/>
    </visual>
  </link>
  <!-- Overhead LED Work Lighting Fixture -->
  <joint name="overhead_lighting_joint" type="fixed">
    <parent link="overhead_gantry_link"/>
    <child link="overhead_lighting_link"/>
    <origin rpy="0 0 0" xyz="0 0.08999999999999997 1.89"/>
  </joint>
  <link name="overhead_lighting_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="2.5"/>
      <inertia ixx="0.04" ixy="0" ixz="0" iyy="0.25" iyz="0" izz="0.28"/>
    </inertial>
    <!-- Lighting Housing -->
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.015"/>
      <geometry>
        <box size="1.05 0.18 0.03"/>
      </geometry>
      <material name="aluminum_silver"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.015"/>
      <geometry>
        <box size="1.05 0.18 0.03"/>
      </geometry>
    </collision>
    <!-- Dual LED Tubes (Emissive White) -->
    <visual>
      <origin rpy="0 1.57079 0" xyz="0 -0.04 -0.005"/>
      <geometry>
        <cylinder length="1.0" radius="0.012"/>
      </geometry>
      <material name="led_white"/>
    </visual>
    <visual>
      <origin rpy="0 1.57079 0" xyz="0 0.04 -0.005"/>
      <geometry>
        <cylinder length="1.0" radius="0.012"/>
      </geometry>
      <material name="led_white"/>
    </visual>
  </link>
  <!-- Overhead Articulated Camera Mount Frame -->
  <joint name="camera_overhead_mount_joint" type="fixed">
    <parent link="overhead_gantry_link"/>
    <child link="camera_overhead_mount_link"/>
    <origin rpy="0 0 0" xyz="0 -0.08000000000000004 1.9"/>
  </joint>
  <link name="camera_overhead_mount_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 -0.08"/>
      <mass value="0.8"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.002"/>
    </inertial>
    <!-- Articulated Magic Arm Bracket -->
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.07"/>
      <geometry>
        <cylinder length="0.14" radius="0.01"/>
      </geometry>
      <material name="hardware_black"/>
    </visual>
    <!-- Camera Body Housing -->
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.15"/>
      <geometry>
        <box size="0.09 0.05 0.03"/>
      </geometry>
      <material name="hardware_black"/>
    </visual>
    <!-- Camera Lens pointing downward -->
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.17"/>
      <geometry>
        <cylinder length="0.02" radius="0.012"/>
      </geometry>
      <material name="aluminum_dark"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.12"/>
      <geometry>
        <box size="0.12 0.10 0.16"/>
      </geometry>
    </collision>
  </link>
  <!-- Overhead Camera Optical Frame (pointing down towards table surface) -->
  <!-- In ROS optical convention: Z forward (down), X right, Y down (forward) -->
  <joint name="camera_overhead_optical_joint" type="fixed">
    <parent link="camera_overhead_mount_link"/>
    <child link="camera_overhead_optical_frame"/>
    <origin rpy="3.14159265 0 -1.5707963" xyz="0 0 -0.18"/>
  </joint>
  <link name="camera_overhead_optical_frame"/>
  <joint name="teach_pendant_mount_joint" type="fixed">
    <parent link="table_base_link"/>
    <child link="teach_pendant_mount_link"/>
    <!-- Mounted on the left side (-half_l), towards the front (-0.18m), at upper frame level -->
    <origin rpy="0 0 0" xyz="-0.585 -0.18 0.66"/>
  </joint>
  <link name="teach_pendant_mount_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.04 0 0"/>
      <mass value="1.8"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
    </inertial>
    <!-- Mounting Arm from Extrusion -->
    <visual>
      <origin rpy="0 0 0" xyz="-0.025 0 0"/>
      <geometry>
        <box size="0.05 0.04 0.04"/>
      </geometry>
      <material name="aluminum_dark"/>
    </visual>
    <!-- Teach Pendant Housing (Screen strictly parallel to side acrylic sheet) -->
    <visual>
      <origin rpy="0 0 0" xyz="-0.05 0 0"/>
      <geometry>
        <box size="0.045 0.32 0.24"/>
      </geometry>
      <material name="teach_pendant_blue"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="-0.05 0 0"/>
      <geometry>
        <box size="0.05 0.34 0.26"/>
      </geometry>
    </collision>
    <!-- Touchscreen Surface (Facing outwards along -X, parallel to side acrylic panel) -->
    <visual>
      <origin rpy="0 0 0" xyz="-0.073 0.02 0"/>
      <geometry>
        <box size="0.002 0.23 0.18"/>
      </geometry>
      <material name="teach_pendant_screen"/>
    </visual>
    <!-- Emergency Stop Button (front side of pendant, protruding outwards in -X) -->
    <visual>
      <origin rpy="0 1.5707963 0" xyz="-0.075 -0.115 -0.02"/>
      <geometry>
        <cylinder length="0.02" radius="0.018"/>
      </geometry>
      <material name="estop_red"/>
    </visual>
    <!-- Status Indicator LED (above E-Stop) -->
    <visual>
      <origin rpy="0 1.5707963 0" xyz="-0.073 -0.115 0.03"/>
      <geometry>
        <cylinder length="0.005" radius="0.008"/>
      </geometry>
      <material name="status_green"/>
    </visual>
  </link>
  <joint name="table_wall_joint" type="fixed">
    <parent link="table_base_link"/>
    <child link="table_wall_link"/>
    <origin rpy="0 0 0" xyz="0 0.51 1.25"/>
  </joint>
  <link name="table_wall_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="50.0"/>
      <inertia ixx="30.0" ixy="0" ixz="0" iyy="40.0" iyz="0" izz="50.0"/>
    </inertial>
    <!-- Base Wall Surface (Cream / Off-white lab wall) -->
