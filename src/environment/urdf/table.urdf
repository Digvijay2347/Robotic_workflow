      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="2.4 0.1 2.5"/>
      </geometry>
      <material name="wall_cream"/>
    </visual>
    <!-- Full Wall Collision Box (Protects MoveIt trajectories from wall collisions) -->
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="2.4 0.1 2.5"/>
      </geometry>
    </collision>
    <!-- Upper Blue Accent Partition Panels (seen in photos) -->
    <!-- Left Blue Panel -->
    <visual>
      <origin rpy="0 0 0" xyz="-0.55 -0.052000000000000005 0.35"/>
      <geometry>
        <box size="0.95 0.004 0.90"/>
      </geometry>
      <material name="wall_blue"/>
    </visual>
    <!-- Right Blue Panel -->
    <visual>
      <origin rpy="0 0 0" xyz="0.55 -0.052000000000000005 0.35"/>
      <geometry>
        <box size="0.95 0.004 0.90"/>
      </geometry>
      <material name="wall_blue"/>
    </visual>
    <!-- Mahogany Wood Divider Frame / Moldings (seen in photos) -->
    <!-- Horizontal Mid-Divider Beam -->
    <visual>
      <origin rpy="0 0 0" xyz="0 -0.054000000000000006 -0.12"/>
      <geometry>
        <box size="2.4 0.008 0.05"/>
      </geometry>
      <material name="wood_trim_brown"/>
    </visual>
    <!-- Top Divider Beam -->
    <visual>
      <origin rpy="0 0 0" xyz="0 -0.054000000000000006 0.82"/>
      <geometry>
        <box size="2.4 0.008 0.05"/>
      </geometry>
      <material name="wood_trim_brown"/>
    </visual>
    <!-- Center Vertical Wood Divider Post -->
    <visual>
      <origin rpy="0 0 0" xyz="0 -0.054000000000000006 0.35"/>
      <geometry>
        <box size="0.05 0.008 0.94"/>
      </geometry>
      <material name="wood_trim_brown"/>
    </visual>
    <!-- Industrial Electrical Enclosure & Outlets on Wall (seen behind robot) -->
    <visual>
      <origin rpy="0 0 0" xyz="-0.22 -0.07 0.08"/>
      <geometry>
        <box size="0.22 0.035 0.28"/>
      </geometry>
      <material name="electrical_grey"/>
    </visual>
    <!-- Red 3-phase industrial power socket -->
    <visual>
      <origin rpy="1.5707963 0 0" xyz="-0.22 -0.09 0.02"/>
      <geometry>
        <cylinder length="0.025" radius="0.035"/>
      </geometry>
      <material name="socket_red"/>
    </visual>
  </link>
</robot>
