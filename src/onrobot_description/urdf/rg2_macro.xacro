<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- OnRobot RG2 configuration -->
  <xacro:property name="onrobot_type" value="rg2" />

  <!-- Common RG2 links, geometry and transmissions -->
  <xacro:include
      filename="$(find onrobot_description)/urdf/inc/rg_common.xacro" />


  <!-- Inner knuckle joint -->
  <xacro:macro name="inner_knuckle_joint"
               params="prefix fingerprefix reflect fixed:=true">

    <xacro:if value="${fixed}">
      <joint name="${prefix}${fingerprefix}_inner_knuckle_joint"
             type="fixed">
        <origin
            xyz="0 ${reflect * -0.007678} 0.1422970"
            rpy="0 0 ${(reflect - 1) * pi / 2}" />
        <parent link="${prefix}onrobot_base_link" />
        <child link="${prefix}${fingerprefix}_inner_knuckle" />
      </joint>
    </xacro:if>
    <xacro:unless value="${fixed}">
      <joint name="${prefix}${fingerprefix}_inner_knuckle_joint"
             type="revolute">
        <origin
            xyz="0 ${reflect * -0.007678} 0.1422970"
            rpy="0 0 ${(reflect - 1) * pi / 2}" />
        <parent link="${prefix}onrobot_base_link" />
        <child link="${prefix}${fingerprefix}_inner_knuckle" />
        <axis xyz="1 0 0" />
        <limit
            lower="-0.785398"
            upper="0.785398"
            velocity="100.0"
            effort="1000" />
        <mimic
            joint="${prefix}finger_joint"
            multiplier="-1"
            offset="0" />
      </joint>
    </xacro:unless>
  </xacro:macro>


  <!-- Inner finger joint -->
  <xacro:macro name="inner_finger_joint"
               params="prefix fingerprefix fixed:=true">

    <xacro:if value="${fixed}">
      <joint name="${prefix}${fingerprefix}_inner_finger_joint"
             type="fixed">
        <origin
            xyz="0 ${-(0.056770-0.017178)} ${0.163974-0.125797}"
            rpy="0 0 0" />
        <parent link="${prefix}${fingerprefix}_outer_knuckle" />
        <child link="${prefix}${fingerprefix}_inner_finger" />
      </joint>
    </xacro:if>
    <xacro:unless value="${fixed}">
      <joint name="${prefix}${fingerprefix}_inner_finger_joint"
             type="revolute">
        <origin
            xyz="0 ${-(0.056770-0.017178)} ${0.163974-0.125797}"
            rpy="0 0 0" />
        <parent link="${prefix}${fingerprefix}_outer_knuckle" />
        <child link="${prefix}${fingerprefix}_inner_finger" />
        <axis xyz="1 0 0" />
        <limit
            lower="-0.872665"
            upper="0.872665"
            velocity="100.0"
            effort="1000" />
        <mimic
            joint="${prefix}finger_joint"
            multiplier="1"
            offset="0" />
      </joint>
    </xacro:unless>

    <!-- Finger tip -->
    <link name="${prefix}${fingerprefix}_finger_tip" />

    <joint name="${prefix}${fingerprefix}_finger_tip_joint"
           type="fixed">
      <origin xyz="0 0.019 0.038" rpy="0 0 0" />
      <parent link="${prefix}${fingerprefix}_inner_finger" />
      <child link="${prefix}${fingerprefix}_finger_tip" />
    </joint>

  </xacro:macro>


  <!-- Main finger joint -->
  <xacro:macro name="finger_joint" params="prefix fixed:=true">

    <xacro:if value="${fixed}">
      <joint name="${prefix}finger_joint" type="fixed">
        <origin
            xyz="0 -0.017178 0.125797"
            rpy="0 0 0" />
        <parent link="${prefix}onrobot_base_link" />
        <child link="${prefix}left_outer_knuckle" />
      </joint>
    </xacro:if>
    <xacro:unless value="${fixed}">
      <link name="${prefix}finger_width_mock_link" />

      <joint name="${prefix}finger_width" type="prismatic">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <parent link="${prefix}onrobot_base_link" />
        <child link="${prefix}finger_width_mock_link" />
        <axis xyz="0 0 1" />
        <limit
            lower="0"
            upper="0.110"
            velocity="0.127"
            effort="40" />
      </joint>

      <joint name="${prefix}finger_joint" type="revolute">
        <origin
            xyz="0 -0.017178 0.125797"
            rpy="0 0 0" />
        <parent link="${prefix}onrobot_base_link" />
        <child link="${prefix}left_outer_knuckle" />
        <axis xyz="-1 0 0" />
        <limit
            lower="-0.558505"
            upper="0.785398"
            velocity="100.0"
            effort="1000" />
        <mimic
            joint="${prefix}finger_width"
            multiplier="${0.85 * ((-0.558505 - 0.785398) / 0.110)}"
            offset="0.785398" />
      </joint>
    </xacro:unless>

    <!-- Left finger linkage -->
    <xacro:finger_joints
        prefix="${prefix}"
        fingerprefix="left"
        reflect="1.0"
        fixed="${fixed}" />

  </xacro:macro>


  <!-- Right outer knuckle joint -->
  <xacro:macro name="right_outer_knuckle_joint" params="prefix fixed:=true">

    <xacro:if value="${fixed}">
      <joint name="${prefix}right_outer_knuckle_joint"
             type="fixed">
        <origin
            xyz="0 0.017178 0.125797"
            rpy="0 0 ${pi}" />
        <parent link="${prefix}onrobot_base_link" />
        <child link="${prefix}right_outer_knuckle" />
      </joint>
    </xacro:if>
    <xacro:unless value="${fixed}">
      <joint name="${prefix}right_outer_knuckle_joint"
             type="revolute">
        <origin
            xyz="0 0.017178 0.125797"
            rpy="0 0 ${pi}" />
        <parent link="${prefix}onrobot_base_link" />
        <child link="${prefix}right_outer_knuckle" />
        <axis xyz="1 0 0" />
        <limit
            lower="-0.785398"
            upper="0.785398"
            velocity="100.0"
            effort="1000" />
        <mimic
            joint="${prefix}finger_joint"
            multiplier="-1"
            offset="0" />
      </joint>
    </xacro:unless>

    <!-- Right finger linkage -->
    <xacro:finger_joints
        prefix="${prefix}"
        fingerprefix="right"
        reflect="-1.0"
        fixed="${fixed}" />

  </xacro:macro>


  <!-- Complete OnRobot RG2 gripper -->
  <xacro:macro name="onrobot_rg2" params="prefix fixed:=true">

    <!-- Main gripper base -->
    <xacro:onrobot_base_link prefix="${prefix}" />

    <!-- Finger geometry -->
    <xacro:finger_links
        prefix="${prefix}"
        fingerprefix="left" />

    <xacro:finger_links
        prefix="${prefix}"
        fingerprefix="right" />

    <!-- Finger joints and linkages -->
    <xacro:finger_joint prefix="${prefix}" fixed="${fixed}" />

    <xacro:right_outer_knuckle_joint prefix="${prefix}" fixed="${fixed}" />

    <!-- Transmission -->
    <xacro:unless value="${fixed}">
      <xacro:transmission_macro
          prefix="${prefix}"
          joint_name="finger_width" />
    </xacro:unless>

    <!-- RG2 TCP -->
    <link name="${prefix}gripper_tcp" />

    <joint name="${prefix}tcp_joint" type="fixed">
      <origin xyz="0 0 0.218" rpy="0 0 0" />
      <parent link="${prefix}onrobot_base_link" />
      <child link="${prefix}gripper_tcp" />
    </joint>

  </xacro:macro>

</robot>
